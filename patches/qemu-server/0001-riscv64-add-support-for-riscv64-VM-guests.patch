@@ -129,6 +167,17 @@ sub initialize_cpu_models {
         ($json_text) = $json_text =~ /(.*)/s; # untaint multi-line string
         $cpu_models_by_arch->{'aarch64'} = eval { decode_json($json_text) }
             or die "unable to decode contents of '$cpu_models_aarch64_file' - $@\n";
+
+        if (-f $cpu_models_riscv64_file) {
+            $json_text = PVE::File::file_get_contents($cpu_models_riscv64_file);
+            ($json_text) = $json_text =~ /(.*)/s; # untaint multi-line string
+            $cpu_models_by_arch->{'riscv64'} = eval { decode_json($json_text) }
+                or die "unable to decode contents of '$cpu_models_riscv64_file' - $@\n";
