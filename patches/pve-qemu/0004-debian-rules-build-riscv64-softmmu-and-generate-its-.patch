From 3bdd44cbc0d0e0b6ae138f8f4d318fdc64134d88 Mon Sep 17 00:00:00 2001
From: daemonhorn <dhorn2000@gmail.com>
Date: Sun, 16 Aug 2026 10:56:32 -0400
Subject: [PATCH qemu 4/4] debian/rules: build riscv64-softmmu and generate its
 machine/CPU-model metadata

Adds riscv64-softmmu to --target-list, alongside the existing
x86_64-softmmu and aarch64-softmmu. Generates
machine-versions-riscv64.json and cpu-models-riscv64.json from the
built binary the same way the other two architectures' metadata is
produced, and adds the corresponding diff-against-golden-file guard
using the newly committed debian/cpu-models-riscv64.json, generated
from an actual build of this tree.

Depends on the parse-cpu-models.pl and parse-machines.pl fixes earlier
in this series - without them, this target addition breaks the build
outright (the -cpu help and -machine help output for riscv64 causes
both scripts to die).

Co-authored-by: Claude Opus 5 <noreply@anthropic.com>
Signed-off-by: daemonhorn <dhorn2000@gmail.com>
---
 debian/cpu-models-riscv64.json | 18 ++++++++++++++++++
 debian/rules                   |  7 ++++++-
 2 files changed, 24 insertions(+), 1 deletion(-)
 create mode 100644 debian/cpu-models-riscv64.json

diff --git a/debian/cpu-models-riscv64.json b/debian/cpu-models-riscv64.json
new file mode 100644
index 0000000..8b2370a
--- /dev/null
+++ b/debian/cpu-models-riscv64.json
@@ -0,0 +1,18 @@
+{
+   "max" : "default",
+   "mips-p8700" : "MIPS",
+   "rv64" : "default",
+   "rv64e" : "default",
+   "rv64i" : "default",
+   "rva22s64" : "default",
+   "rva22u64" : "default",
+   "rva23s64" : "default",
+   "rva23u64" : "default",
+   "shakti-c" : "Shakti",
+   "sifive-u54" : "SiFive",
+   "thead-c906" : "THEAD",
+   "tt-ascalon" : "Tenstorrent",
+   "veyron-v1" : "Ventana Micro Systems",
+   "xiangshan-kunminghu" : "XiangShan",
+   "xiangshan-nanhu" : "XiangShan"
+}
diff --git a/debian/rules b/debian/rules
index a6b8745..c71fe5a 100755
--- a/debian/rules
+++ b/debian/rules
@@ -13,9 +13,11 @@ flagfile := $(destdir)/usr/share/kvm/recognized-CPUID-flags-x86_64
 
 machine_file_x86_64 := $(destdir)/usr/share/kvm/machine-versions-x86_64.json
 machine_file_aarch64 := $(destdir)/usr/share/kvm/machine-versions-aarch64.json
+machine_file_riscv64 := $(destdir)/usr/share/kvm/machine-versions-riscv64.json
 
 cpu_models_file_x86_64 := $(destdir)/usr/share/kvm/cpu-models-x86_64.json
 cpu_models_file_aarch64 := $(destdir)/usr/share/kvm/cpu-models-aarch64.json
+cpu_models_file_riscv64 := $(destdir)/usr/share/kvm/cpu-models-riscv64.json
 
 # default QEMU out-of-tree build directory is ./build
 BUILDDIR=build
@@ -46,7 +48,7 @@ endif
 	    --localstatedir=/var \
 	    --prefix=/usr \
 	    --sysconfdir=/etc \
-	    --target-list=x86_64-softmmu,aarch64-softmmu \
+	    --target-list=x86_64-softmmu,aarch64-softmmu,riscv64-softmmu \
 	    --with-suffix="kvm" \
 	    --with-pkgversion="${DEB_SOURCE}_${DEB_VERSION_UPSTREAM_REVISION}" \
 	    --audio-drv-list="alsa" \
@@ -136,15 +138,18 @@ install: build
 	# Supported machine versions are static for a given QEMU binary.
 	$(destdir)/usr/bin/qemu-system-x86_64 -machine help | ./debian/parse-machines.pl > $(machine_file_x86_64)
 	$(destdir)/usr/bin/qemu-system-aarch64 -machine help | ./debian/parse-machines.pl > $(machine_file_aarch64)
+	$(destdir)/usr/bin/qemu-system-riscv64 -machine help | ./debian/parse-machines.pl > $(machine_file_riscv64)
 
 	# Supported CPU models are static for a given QEMU binary.
 	$(destdir)/usr/bin/qemu-system-x86_64 -cpu help | ./debian/parse-cpu-models.pl > $(cpu_models_file_x86_64)
 	$(destdir)/usr/bin/qemu-system-aarch64 -cpu help | ./debian/parse-cpu-models.pl > $(cpu_models_file_aarch64)
+	$(destdir)/usr/bin/qemu-system-riscv64 -cpu help | ./debian/parse-cpu-models.pl > $(cpu_models_file_riscv64)
 	# NOTE: If the diff fails here after upgrading the QEMU submodule, check which new models
 	# are to be picked up and which are to be excluded, adapt to other changes and commit the
 	# new expected files (and parse-cpu-models.pl script).
 	diff -u $(cpu_models_file_x86_64) ./debian/cpu-models-x86_64.json
 	diff -u $(cpu_models_file_aarch64) ./debian/cpu-models-aarch64.json
+	diff -u $(cpu_models_file_riscv64) ./debian/cpu-models-riscv64.json
 
 # Build architecture-independent files here.
 binary-indep: build install
-- 
