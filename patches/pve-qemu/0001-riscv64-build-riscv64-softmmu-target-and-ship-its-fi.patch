From cba03c19695663cc0f510d785351be9f8b9f1724 Mon Sep 17 00:00:00 2001
From: daemonhorn <dhorn2000@gmail.com>
Date: Sat, 15 Aug 2026 20:56:27 -0400
Subject: [PATCH] riscv64: build riscv64-softmmu target and ship its firmware

Adds riscv64-softmmu to --target-list and generates the machine-version
and CPU-model metadata for it, mirroring x86_64 and aarch64.

Three real build failures found by actually building this target:

parse-cpu-models.pl had no riscv64 handling and died on every riscv64
CPU model. Adds vendor detection for the SiFive/THEAD/Ventana/Shakti/
Tenstorrent/XiangShan cores and the generic rv64* ISA profiles, skips
32-bit and experimental cores, and handles mips-p8700 (MIPS' P8700 has
a RISC-V-compatible mode and appears in riscv64 -cpu help). Note the
vendor strings are best-effort attributions -- unlike x86/ARM, QEMU's
riscv64 -cpu help has no vendor column to parse.

parse-machines.pl died on riscv64 because its virt machine has no
versioned variants upstream, unlike pc-*/virt-* on x86_64/aarch64. Zero
matches is a legitimate result for such a target, so warn instead of
dying.

The PC_BIOS_FW_PURGE_LIST_IN entry `opensbi-riscv.*-generic-fw_dynamic.bin`
matched both widths. QEMU's riscv64 virt machine uses the 64-bit blob as
its *default* BIOS, so purging it made every riscv64 guest fail to start
with "Unable to find the RISC-V BIOS". Confirmed on a real install, where
/usr/share/kvm/ contained no opensbi files at all. Now purges only the
riscv32 blob; no riscv32-softmmu target is built.

debian/cpu-models-riscv64.json is generated from an actual build of this
tree and guarded by a diff check like the other architectures.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015sQUuNrGk7QcVLxJHWmcme
---
 Makefile                       | 11 ++++++-
 debian/changelog               | 28 ++++++++++++++++++
 debian/cpu-models-riscv64.json | 18 ++++++++++++
 debian/parse-cpu-models.pl     | 52 ++++++++++++++++++++++++++++++++++
 debian/parse-machines.pl       |  9 +++++-
 debian/rules                   |  7 ++++-
 6 files changed, 122 insertions(+), 3 deletions(-)
 create mode 100644 debian/cpu-models-riscv64.json

diff --git a/Makefile b/Makefile
index 2ead600..0b3f2d0 100644
--- a/Makefile
+++ b/Makefile
@@ -22,6 +22,15 @@ ifeq ($(shell test -f "$(SRCDIR)/configure" && echo 1 || echo 0), 0)
 	cd $(SRCDIR); meson subprojects download
 endif
 
+# NOTE: the riscv64 OpenSBI blob must NOT be purged. QEMU's riscv64 'virt' machine uses
+# opensbi-riscv64-generic-fw_dynamic.bin as its *default* BIOS, so removing it makes every riscv64
+# guest fail to start with:
+#   qemu-system-riscv64: Unable to find the RISC-V BIOS "opensbi-riscv64-generic-fw_dynamic.bin"
+# Confirmed empirically: `qm start` on an arch=riscv64 guest failed exactly this way on a real PVE
+# install built from this tree, with /usr/share/kvm/ containing zero opensbi files.
+# This entry previously read 'opensbi-riscv.*-generic-fw_dynamic.bin', whose '.*' matched both
+# widths - harmless while only x86_64/aarch64 targets were built, but wrong once riscv64-softmmu is
+# in --target-list. riscv32 stays purged, as no riscv32-softmmu target is built.
 PC_BIOS_FW_PURGE_LIST_IN = \
 	hppa-firmware.img \
 	hppa-firmware64.img \
@@ -34,7 +43,7 @@ PC_BIOS_FW_PURGE_LIST_IN = \
 	u-boot.e500 \
 	qemu_vga.ndrv \
 	slof.bin \
-	opensbi-riscv.*-generic-fw_dynamic.bin \
+	opensbi-riscv32-generic-fw_dynamic.bin \
 
 BLOB_PURGE_SED_CMDS = $(foreach FILE,$(PC_BIOS_FW_PURGE_LIST_IN),-e "/$(FILE)/d")
 BLOB_PURGE_FILTER = $(foreach FILE,$(PC_BIOS_FW_PURGE_LIST_IN),-e "$(FILE)")
diff --git a/debian/changelog b/debian/changelog
index d564272..0a0ceb7 100644
--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,31 @@
+pve-qemu-kvm (11.0.3-2+riscv2) trixie; urgency=medium
+
+  * Stop purging pc-bios/opensbi-riscv64-generic-fw_dynamic.bin. QEMU's riscv64
+    'virt' machine uses this blob as its default BIOS, so removing it made every
+    riscv64 guest fail to start with:
+      qemu-system-riscv64: Unable to find the RISC-V BIOS
+      "opensbi-riscv64-generic-fw_dynamic.bin"
+    The purge list entry read 'opensbi-riscv.*-generic-fw_dynamic.bin', whose
+    '.*' matched both 32- and 64-bit blobs; it now names the riscv32 blob
+    explicitly. Found by end-to-end testing of a real PVE install.
+
+ -- Proxmox riscv64 support <support@proxmox.com>  Sat, 15 Aug 2026 19:01:31 -0400
+
+pve-qemu-kvm (11.0.3-2+riscv1) trixie; urgency=medium
+
+  * Add riscv64 guest support: build the riscv64-softmmu QEMU target, generate
+    and ship cpu-models-riscv64.json and machine-versions-riscv64.json, and
+    teach debian/parse-cpu-models.pl about riscv64 CPU model naming
+    (including the mips-p8700 core exposed by the riscv64 target).
+
+  * debian/parse-machines.pl: warn instead of dying when a target exposes no
+    versioned machine types, as riscv64's virt board does.
+
+  * Locally versioned (+riscv1) so these packages are distinguishable from,
+    and sort newer than, the stock Proxmox packages of the same version.
+
+ -- Proxmox riscv64 support <support@proxmox.com>  Sat, 15 Aug 2026 18:31:53 -0400
+
 pve-qemu-kvm (11.0.3-2) trixie; urgency=medium
 
   * add fix for re-entrant DMA issue with LSI SCSI controllers
diff --git a/debian/cpu-models-riscv64.json b/debian/cpu-models-riscv64.json
new file mode 100644
index 0000000..8b2370a
--- /dev/null
+++ b/debian/cpu-models-riscv64.json
@@ -0,0 +1,18 @@
+{
+   "max" : "default",
+   "mips-p8700" : "MIPS",
+   "rv64" : "default",
+   "rv64e" : "default",
+   "rv64i" : "default",
+   "rva22s64" : "default",
+   "rva22u64" : "default",
+   "rva23s64" : "default",
+   "rva23u64" : "default",
+   "shakti-c" : "Shakti",
+   "sifive-u54" : "SiFive",
+   "thead-c906" : "THEAD",
+   "tt-ascalon" : "Tenstorrent",
+   "veyron-v1" : "Ventana Micro Systems",
+   "xiangshan-kunminghu" : "XiangShan",
+   "xiangshan-nanhu" : "XiangShan"
+}
diff --git a/debian/parse-cpu-models.pl b/debian/parse-cpu-models.pl
index c5e7bfa..05cd423 100755
--- a/debian/parse-cpu-models.pl
+++ b/debian/parse-cpu-models.pl
@@ -42,6 +42,20 @@ my @skip_models = (
     'sa1110',
     'ti925t',
     # some more are skipped based on being deprecated
+
+    # riscv64: 32-bit-only or experimental cores have no place in the 64-bit guest CPU model list
+    # (get_cpu_bitness() in qemu-server always reports 64 for arch=riscv64), mirroring how 32-bit
+    # ARM cores are skipped above for aarch64.
+    'lowrisc-ibex', # 32-bit (Ibex)
+    'max32',
+    'rv32',
+    'rv32e',
+    'rv32i',
+    'sifive-e31', # 32-bit (SiFive E-series, embedded)
+    'sifive-e34',
+    'sifive-e51',
+    'sifive-u34', # 32-bit variant of the U-series (unlike the 64-bit sifive-u54)
+    'x-rv128', # experimental 128-bit
 );
 my $skip_models_re = qr/(@{[join('|', @skip_models)]})/;
 
@@ -76,6 +90,44 @@ while (my $line = <STDIN>) {
         } elsif ($model =~ m/^(a64fx|cortex-|neoverse-).*$/) {
             $cpu_models->{$model} = 'ARM';
             next;
+        } elsif ($model =~ m/^(rv64|rv64e|rv64i|rva22s64|rva22u64|rva23s64|rva23u64)$/) {
+            # generic RISC-V ISA-profile CPUs, not tied to a specific vendor's silicon.
+            #
+            # NOTE on the whole riscv64 branch below: the *model names* were confirmed by
+            # actually running `qemu-system-riscv64 -cpu help` (QEMU 10.0.11) through this
+            # script end-to-end. The *vendor strings* assigned to each (SiFive/THEAD/Ventana
+            # Micro Systems/Shakti/Tenstorrent/XiangShan) are this author's best-effort
+            # attribution from public knowledge of each core, since QEMU's riscv64 `-cpu help`
+            # output has no vendor column to parse (unlike the AMD/Intel/ARM branches above,
+            # which read the vendor directly from QEMU's own output) - double check them, they
+            # are guesses, not parsed data.
+            $cpu_models->{$model} = 'default';
+            next;
+        } elsif ($model =~ m/^sifive-/) {
+            $cpu_models->{$model} = 'SiFive';
+            next;
+        } elsif ($model =~ m/^thead-/) {
+            $cpu_models->{$model} = 'THEAD';
+            next;
+        } elsif ($model eq 'veyron-v1') {
+            $cpu_models->{$model} = 'Ventana Micro Systems';
+            next;
+        } elsif ($model eq 'shakti-c') {
+            $cpu_models->{$model} = 'Shakti';
+            next;
+        } elsif ($model eq 'tt-ascalon') {
+            $cpu_models->{$model} = 'Tenstorrent';
+            next;
+        } elsif ($model =~ m/^xiangshan-/) {
+            $cpu_models->{$model} = 'XiangShan';
+            next;
+        } elsif ($model eq 'mips-p8700') {
+            # confirmed present in a real `qemu-system-riscv64 -cpu help` (pve-qemu-kvm 11.0.3)
+            # build, though absent from the QEMU 10.0.11 build used to write the branch above -
+            # MIPS' P8700 core has an optional RISC-V-compatible execution mode, hence the entry
+            # under the riscv64 target's CPU list despite the vendor name.
+            $cpu_models->{$model} = 'MIPS';
+            next;
         }
         die "unable to deal with line '$line' - implement me"
     } elsif ($info =~ m/^\(deprecated\)$/) {
diff --git a/debian/parse-machines.pl b/debian/parse-machines.pl
index a6c0e8d..fc70e29 100755
--- a/debian/parse-machines.pl
+++ b/debian/parse-machines.pl
@@ -22,7 +22,14 @@ while (<STDIN>) {
     };
 }
 
-die "no QEMU machine types detected from STDIN input" if scalar (@$machines) <= 0;
+# NOTE: unlike x86_64's pc-(i440fx|q35)-* and aarch64's virt-*, riscv64's virt machine (as of
+# QEMU 11.0.3, confirmed via a real `qemu-system-riscv64 -machine help`) has no versioned
+# variants at all - upstream hasn't opted that board into the MACHINE_VER_* deprecation macros
+# used by 0039-adapt-machine-version-deprecation-for-Proxmox-VE.patch, so zero matches here is
+# an expected, legitimate outcome for riscv64, not a sign this script broke. Warn instead of
+# dying so a future arch/board addition without versioned machines doesn't hard-fail the build,
+# while still surfacing the empty result for visibility.
+warn "no QEMU machine types detected from STDIN input\n" if scalar (@$machines) <= 0;
 
 print to_json($machines, { utf8 => 1, canonical => 1 })
     or die "failed to encode detected machines as JSON - $!\n";
diff --git a/debian/rules b/debian/rules
index a6b8745..c71fe5a 100755
--- a/debian/rules
+++ b/debian/rules
@@ -13,9 +13,11 @@ flagfile := $(destdir)/usr/share/kvm/recognized-CPUID-flags-x86_64
 
 machine_file_x86_64 := $(destdir)/usr/share/kvm/machine-versions-x86_64.json
 machine_file_aarch64 := $(destdir)/usr/share/kvm/machine-versions-aarch64.json
+machine_file_riscv64 := $(destdir)/usr/share/kvm/machine-versions-riscv64.json
 
 cpu_models_file_x86_64 := $(destdir)/usr/share/kvm/cpu-models-x86_64.json
 cpu_models_file_aarch64 := $(destdir)/usr/share/kvm/cpu-models-aarch64.json
+cpu_models_file_riscv64 := $(destdir)/usr/share/kvm/cpu-models-riscv64.json
 
 # default QEMU out-of-tree build directory is ./build
 BUILDDIR=build
@@ -46,7 +48,7 @@ endif
 	    --localstatedir=/var \
 	    --prefix=/usr \
 	    --sysconfdir=/etc \
-	    --target-list=x86_64-softmmu,aarch64-softmmu \
+	    --target-list=x86_64-softmmu,aarch64-softmmu,riscv64-softmmu \
 	    --with-suffix="kvm" \
 	    --with-pkgversion="${DEB_SOURCE}_${DEB_VERSION_UPSTREAM_REVISION}" \
 	    --audio-drv-list="alsa" \
@@ -136,15 +138,18 @@ install: build
 	# Supported machine versions are static for a given QEMU binary.
 	$(destdir)/usr/bin/qemu-system-x86_64 -machine help | ./debian/parse-machines.pl > $(machine_file_x86_64)
 	$(destdir)/usr/bin/qemu-system-aarch64 -machine help | ./debian/parse-machines.pl > $(machine_file_aarch64)
+	$(destdir)/usr/bin/qemu-system-riscv64 -machine help | ./debian/parse-machines.pl > $(machine_file_riscv64)
 
 	# Supported CPU models are static for a given QEMU binary.
 	$(destdir)/usr/bin/qemu-system-x86_64 -cpu help | ./debian/parse-cpu-models.pl > $(cpu_models_file_x86_64)
 	$(destdir)/usr/bin/qemu-system-aarch64 -cpu help | ./debian/parse-cpu-models.pl > $(cpu_models_file_aarch64)
+	$(destdir)/usr/bin/qemu-system-riscv64 -cpu help | ./debian/parse-cpu-models.pl > $(cpu_models_file_riscv64)
 	# NOTE: If the diff fails here after upgrading the QEMU submodule, check which new models
 	# are to be picked up and which are to be excluded, adapt to other changes and commit the
 	# new expected files (and parse-cpu-models.pl script).
 	diff -u $(cpu_models_file_x86_64) ./debian/cpu-models-x86_64.json
 	diff -u $(cpu_models_file_aarch64) ./debian/cpu-models-aarch64.json
+	diff -u $(cpu_models_file_riscv64) ./debian/cpu-models-riscv64.json
 
 # Build architecture-independent files here.
 binary-indep: build install
-- 
2.47.3

