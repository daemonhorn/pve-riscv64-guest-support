From f1ef1b29f90fd651b057a6370b163cd8bef1f898 Mon Sep 17 00:00:00 2001
From: daemonhorn <dhorn2000@gmail.com>
Date: Sun, 16 Aug 2026 10:57:10 -0400
Subject: [PATCH edk2-firmware] riscv64: enable TPM2 support in the RiscVVirt
 firmware build

Adds TPM2_ENABLE and TPM2_CONFIG_ENABLE to RISCV64_FLAGS. Both PCDs
are defined and gated for this platform in
OvmfPkg/RiscVVirt/RiscVVirtQemu.dsc, so the riscv64 virt firmware can
support a vTPM the same way the aarch64 and OVMF builds do. The
riscv64 target, its install file and package stanza already existed;
only the TPM flags were missing.

Also ignores the staged pve-edk2-firmware-*.*/ build directory
(~6GB), which was not covered by the existing .deb/.buildinfo/.changes
patterns.

Verified: the built RISCV_VIRT_CODE.fd and RISCV_VIRT_VARS.fd are
33554432 bytes each with valid _FVH firmware volume headers, and the
firmware initializes to the EDK2 boot manager in a riscv64 guest.

Co-authored-by: Claude Opus 5 <noreply@anthropic.com>
Signed-off-by: daemonhorn <dhorn2000@gmail.com>
---
 .gitignore   | 1 +
 debian/rules | 4 +++-
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/.gitignore b/.gitignore
index a4c231b..c7fb4c1 100644
--- a/.gitignore
+++ b/.gitignore
@@ -2,3 +2,4 @@
 *.buildinfo
 *.changes
 edk2.build
+/pve-edk2-firmware-*.*/
diff --git a/debian/rules b/debian/rules
index 8abc6a7..edbfa07 100755
--- a/debian/rules
+++ b/debian/rules
@@ -46,7 +46,9 @@ AAVMF_FLAGS += -DTPM2_CONFIG_ENABLE=TRUE
 AAVMF_FLAGS += -DCAVIUM_ERRATUM_27456=TRUE
 AAVMF_SECBOOT_FLAGS = $(AAVMF_FLAGS) -DBUILD_SHELL=FALSE -DSECURE_BOOT_ENABLE=TRUE
 
-RISCV64_FLAGS = $(COMMON_FLAGS)
+RISCV64_FLAGS  = $(COMMON_FLAGS)
+RISCV64_FLAGS += -DTPM2_ENABLE=TRUE
+RISCV64_FLAGS += -DTPM2_CONFIG_ENABLE=TRUE
 
 # Clear variables used internally by the edk2 build system
 undefine WORKSPACE
-- 
2.47.3

