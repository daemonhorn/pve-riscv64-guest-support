--- /dev/null
+++ b/src/test/cfg2cmd/riscv64/simple-riscv.conf
@@ -0,0 +1,34 @@
+# TEST: Simple test for a basic configuration with riscv64 set as architecture, on the default
+# (x86_64) test host - exercises the same cross-architecture TCG path used for aarch64-on-x86_64,
+# plus the UART serial console and sysbus TPM device model fixed alongside riscv64 support.
+#
+# NOTE for whoever runs this fixture first: no `.cmd` golden file is committed alongside this
+# `.conf` yet, so the test harness (see do_test() in run_config2command_tests.pl) will silently
+# *write* one from whatever the code currently emits on first run, not validate anything. Before
+# committing the generated `simple-riscv.conf.cmd`, diff it line-by-line against
+# `../aarch64/simple-arm.conf.cmd` and confirm every difference is intentional (arch/binary name,
+# RISCV_VIRT_CODE/VARS.fd paths+size, `-cpu max`, the serial0/tpmstate0 lines this fixture adds
+# that the aarch64 one doesn't). In particular, the `virtio-gpu` display device choice
+# ($vga_map_no_legacy_vga in QemuServer.pm) was extended to riscv64 by analogy with aarch64's
+# existing behavior but was NOT independently verified against a real riscv64-capable QEMU
+# build (the QEMU binary used to verify the TPM device model and CPU list, from Debian's
+# qemu-system-riscv package, wasn't built with --enable-virglrenderer/--enable-opengl so it
+# has no virtio-gpu compiled in at all) - pay particular attention to that line.
+arch: riscv64
+bootdisk: scsi0
+bios: ovmf
+cores: 3
+ide2: none,media=cdrom
+memory: 768
+name: simple
+net0: virtio=A2:C0:43:77:08:A0,bridge=vmbr0
+numa: 0
+ostype: l26
+scsi0: local:8006/vm-8006-disk-0.qcow2,discard=on,size=104858K
+scsihw: virtio-scsi-pci
+serial0: socket
+smbios1: uuid=7b10d7af-b932-4c66-b2c3-3996152ec465
+sockets: 1
+vmgenid: c773c261-d800-4348-9f5d-167fadd53cf8
+efidisk0: local:8006/vm-8006-disk-1.qcow2,efitype=4m
+tpmstate0: local:8006/vm-8006-disk-2.raw,size=4M,version=v2.0
