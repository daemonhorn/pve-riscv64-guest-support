+            # so this doesn't break x86_64/aarch64 VMs on hosts that haven't upgraded yet.
+            $cpu_models_by_arch->{'riscv64'} = $riscv64_fallback_cpu_models;
+        }
     } else { # FIXME: MAJOR VERSION: remove hard-coded list
         $cpu_models_by_arch = {
             x86_64 => {
@@ -242,6 +291,7 @@ sub initialize_cpu_models {
